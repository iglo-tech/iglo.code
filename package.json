      "@effect/platform-node-shared": "4.1.2",
      "@effect/vitest": "4.1.2",
      "@legendapp/list": "3.7.3",
      "@noble/curves": "1.9.1",
      "@noble/hashes": "1.8.0",
      "@pierre/diffs": "1.7.0-beta.4",
      "@pierre/highlights": "0.5.0",
      "@tailwindcss/node": "4.3.3",
      "@tailwindcss/oxide": "4.3.3",
      "@tailwindcss/vite": "4.3.3",
      "@types/node": "24.12.4",
      "@types/react": "~19.3.0",
      "@types/react-dom": "~19.3.0",
      "@types/ws": "8.18.2",
      "effect": "4.1.3",
      "jose": "6.2.2",
      "lightningcss": "1.33.0",
