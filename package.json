{
  "name": "@t3tools/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "evals",
      "!apps/desktop",
      "!apps/mobile",
      "oxlint-plugin-t3code",
      "packages/*",
      "scripts"
    ],
    "catalog": {
      "@clerk/clerk-js": "6.42.3",
      "@clerk/electron": "0.1.10",
