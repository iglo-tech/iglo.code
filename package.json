      "react-dom": "19.3.0",
      "tailwindcss": "4.3.3",
      "undici": "8.12.4",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
      "vite-plus": "1.4.0",
      "ws": "8.22.0",
      "yaml": "^2.9.0",
      "mdast-util-directive": "3.1.0",
      "micromark-extension-directive": "4.0.0",
      "micromark-util-character": "2.1.1",
      "micromark-util-decode-string": "2.0.1",
      "micromark-util-types": "2.0.2",
      "rehype-raw": "7.0.0",
      "rehype-sanitize": "6.0.0",
      "remark-breaks": "4.0.0",
      "remark-gfm": "4.0.1",
      "remark-parse": "11.0.0",
      "remark-rehype": "11.1.2",
      "unified": "11.0.5"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "bun scripts/dev-runner.ts dev",
    "dev:share": "bun scripts/dev-runner.ts dev --share",
    "dev:server": "bun scripts/dev-runner.ts dev:server",
    "dev:web": "bun scripts/dev-runner.ts dev:web",
    "migrate-dev-db": "bun apps/server/scripts/migrate-dev-db.ts",
    "start": "vp run --filter t3 start",
    "icons:export": "bun scripts/export-brand-icons.ts",
    "icons:check": "bun scripts/export-brand-icons.ts --check",
    "i18n:check": "bun scripts/i18n-check.ts",
    "licenses:sync": "bun scripts/sync-third-party-license-notices.ts",
    "build": "vp run --filter './apps/*' build",
    "build:resource-monitor": "cargo build --locked --release --manifest-path native/resource-monitor/Cargo.toml",
    "typecheck": "vp run -r --cache --concurrency-limit 4 typecheck",
    "tc": "vp run -r --cache --concurrency-limit 4 typecheck",
    "check:changed": "node scripts/check-changed.ts",
    "report:renders": "node scripts/render-metrics.ts",
    "lint": "vp lint --report-unused-disable-directives",
    "i18n:untranslated": "node scripts/i18n-untranslated.ts",
    "knip": "knip --preprocessor ./scripts/knip-schemas.ts",
    "knip:check": "vp run knip:check:files && vp run knip:check:exports",
    "knip:check:files": "knip --include files,dependencies --no-config-hints",
    "knip:check:exports": "knip --workspace apps/server --workspace apps/web --workspace packages/client-runtime --workspace packages/contracts --workspace packages/effect-acp --workspace packages/effect-codex-app-server --workspace packages/shared --workspace packages/ssh --workspace packages/tailscale --workspace packages/provider-core --workspace packages/provider-acp --workspace packages/provider-acp-registry --workspace packages/provider-testing --workspace packages/provider-pi --workspace packages/provider-muse --workspace packages/provider-opencode --workspace packages/provider-cursor --workspace packages/provider-fx --workspace packages/provider-grok --workspace packages/provider-kiro --workspace packages/secret-provider-core --workspace packages/secret-provider-definitions --workspace packages/secret-provider-onepassword --workspace packages/source-control-core --workspace packages/source-control-cursor-origin --workspace packages/source-control-definitions --workspace packages/source-control-azure-devops --workspace packages/source-control-bitbucket --workspace packages/source-control-forgejo --workspace packages/source-control-gitcafe --workspace packages/source-control-github --workspace packages/source-control-gitlab --workspace packages/source-control-tanstack-source --workspace packages/source-control-testing --exports --preprocessor ./scripts/knip-schemas.ts --no-config-hints",
    "knip:production": "knip --production --preprocessor ./scripts/knip-schemas.ts",
    "test": "vp run -r test",
    "test:perf:v2-wire": "vp test run apps/server/src/orchestration-v2/WireProjection.test.ts apps/server/src/orchestration-v2/threadHistoryPaging.test.ts apps/server/src/orchestration-v2/ThreadStream.test.ts apps/server/src/orchestration-v2/ThreadTransportPerformance.test.ts apps/server/src/orchestration-v2/ShellStream.test.ts apps/server/src/orchestration-v2/CommandPolicy.test.ts apps/server/src/orchestration-v2/runtimeLayer.test.ts apps/server/src/ws.test.ts packages/contracts/src/orchestrationV2.test.ts packages/client-runtime/src/operations/commands.test.ts packages/client-runtime/src/operations/commands.performance.test.ts packages/client-runtime/src/state/boundedThreadSnapshotHttp.test.ts packages/client-runtime/src/state/threadHistoryController.test.ts packages/client-runtime/src/state/threadHistoryMerge.test.ts packages/client-runtime/src/state/threads-sync.test.ts packages/client-runtime/src/state/shellReducer.test.ts",
    "test:resource-monitor": "cargo test --locked --manifest-path native/resource-monitor/Cargo.toml",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "release:smoke": "bun scripts/release-smoke.ts",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist .vite-plus apps/*/.vite-plus packages/*/.vite-plus",
    "sync:repos": "bun scripts/sync-reference-repos.ts"
  },
  "devDependencies": {
    "@coderabbitai/config": "1.2.0",
    "@effect/tsgo": "0.67.1",
    "@shadcn/lint": "0.1.5",
    "@types/node": "catalog:",
    "knip": "6.34.0",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk>@anthropic-ai/claude-agent-sdk-darwin-arm64": "-",
